# Postgres (PostGIS + pgvector)
POSTGRES_USER=nckh
POSTGRES_PASSWORD=nckh
POSTGRES_DB=nckh

# Wired into services by docker-compose; override for non-docker local runs
DATABASE_URL=postgresql+psycopg://nckh:nckh@db:5432/nckh
REDIS_URL=redis://redis:6379/0
NEXT_PUBLIC_API_URL=http://localhost:8000

# Phần crawler thuộc bộ phận khác: tắt scheduler mặc định.
# Chỉ đặt true khi chủ động kiểm thử/tích hợp crawler.
CRAWLER_ENABLED=false

# Auth — ĐẶT GIÁ TRỊ THẬT trong .env, KHÔNG commit
JWT_SECRET=change-me-random-64-chars
JWT_ALGORITHM=HS256
ACCESS_TOKEN_TTL_MIN=15
REFRESH_TOKEN_TTL_DAYS=7
GOOGLE_CLIENT_ID=
AUTH_COOKIE_SECURE=false
SMTP_HOST=
SMTP_PORT=587
SMTP_USER=
SMTP_PASSWORD=
SMTP_FROM=no-reply@localhost
SMTP_STARTTLS=true
WEB_PUBLIC_URL=http://localhost:3000
# Native Next.js dev; Docker injects GOOGLE_CLIENT_ID as this build argument.
NEXT_PUBLIC_GOOGLE_CLIENT_ID=
INSTALL_ML=false

# AI Chat — auto ưu tiên Gemini khi có khóa; Qwen local là dự phòng.
CHATBOT_LLM_PROVIDER=auto
CHATBOT_LLM_TIMEOUT_SECONDS=60
CHATBOT_LEGAL_TIMEOUT_SECONDS=180
CHATBOT_CONFIDENCE_THRESHOLD=0.65
CHATBOT_MAX_RESULTS=5
CHATBOT_EMBEDDING_MODEL=intfloat/multilingual-e5-small

# API chạy trực tiếp trên Windows dùng localhost. Container API dùng biến riêng
# OLLAMA_DOCKER_BASE_URL để gọi Ollama trên máy host.
OLLAMA_BASE_URL=http://localhost:11434
OLLAMA_DOCKER_BASE_URL=http://host.docker.internal:11434
OLLAMA_MODEL=qwen3.5:9b
CHATBOT_LEGAL_SCHEMA=public
CHATBOT_LISTING_SCHEMA=public
CHATBOT_GRAPH_ENABLED=false
CHATBOT_GRAPH_SCHEMA=graph_rag_v1
CHATBOT_AGENTS_ENABLED=false
CHATBOT_QUESTION_ANALYSIS_MODEL=gemini-3.1-flash-lite
CHATBOT_QUESTION_ANALYSIS_TIMEOUT_SECONDS=30
# When agents are enabled: Qwen selects evidence, Gemini writes and verifies.
CHATBOT_ANSWER_SYNTHESIS_ENABLED=true
# Empty uses GEMINI_MODEL; configured proxy aliases are preserved.
CHATBOT_ANSWER_SYNTHESIS_MODEL=
CHATBOT_ANSWER_SYNTHESIS_TIMEOUT_SECONDS=60
OLLAMA_CONTEXT_LENGTH=8192
OLLAMA_KEEP_ALIVE=30m
CHATBOT_MAX_OUTPUT_TOKENS=1536
CHATBOT_WARMUP_ENABLED=true
CHATBOT_WARMUP_TIMEOUT_SECONDS=30
LISTING_STATS_CACHE_SECONDS=30

# Để trống và điền sau. Không commit file .env.
GEMINI_API_KEY=
GEMINI_API_KEY_1=
GEMINI_API_KEY_2=
GEMINI_API_KEY_3=
GEMINI_MODEL=gemini-3.5-flash-lite
GEMINI_FALLBACK_MODEL=gemini-3.1-flash-lite
GEMINI_MIN_REQUEST_INTERVAL_SECONDS=5
GEMINI_BASE_URL=https://generativelanguage.googleapis.com/v1beta
# Proxy local: đặt các giá trị dưới đây trong .env, cùng GEMINI_API_KEY của proxy.
# Xóa GEMINI_API_KEY_1/2/3 cũ khi chuyển từ Google trực tiếp sang proxy.
# CHATBOT_LLM_PROVIDER=gemini
# CHATBOT_AGENTS_ENABLED=false
# GEMINI_MODEL=gemini-3.8-flash-high
# GEMINI_BASE_URL=http://127.0.0.1:8317/v1beta
# GEMINI_DOCKER_BASE_URL=http://host.docker.internal:8317/v1beta
RAGAS_JUDGE_PROVIDER=gemini
RAGAS_JUDGE_MODEL=gemini-3.1-flash-lite

# Risk engine được chạy sau crawler và khi user tạo/sửa tin.
RISK_AUTO_ASSESS=true
RISK_AUTO_ASSESS_LIMIT=1000

# OpenRouteService — để trống nếu chưa dùng đường đi thật.
ORS_API_KEY=
